generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Opportunity {
  id               String             @id @default(cuid())
  slug             String             @unique
  title            String
  company          String
  companyLogo      String?
  aboutCompany     String?
  type             String
  workMode         String
  location         String
  experience       String?
  duration         String?
  salary           String?
  skills           String[]
  overview         String?
  responsibilities String?
  qualifications   String?
  benefits         String?
  applyLink        String
  isNew            Boolean            @default(true)
  isVerified       Boolean            @default(false)
  isTrending       Boolean            @default(false)
  isActivelyHiring Boolean            @default(true)
  published        Boolean            @default(true)
  postedAt         DateTime           @default(now())
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deadline         DateTime?
  views            Int                @default(0)
  applyClicks      Int                @default(0)
  clicksLog        OpportunityClick[]
  viewsLog         OpportunityView[]

  @@index([type])
  @@index([slug])
  @@index([location])
  @@index([workMode])
  @@index([postedAt])
  @@index([isTrending])
  @@index([isVerified])
  @@index([published])
}

model OpportunityView {
  id            String      @id @default(cuid())
  opportunityId String
  sessionId     String?
  viewedAt      DateTime    @default(now())
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@index([viewedAt])
  @@index([sessionId])
}

model OpportunityClick {
  id            String      @id @default(cuid())
  opportunityId String
  sessionId     String?
  clickedAt     DateTime    @default(now())
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@index([clickedAt])
  @@index([sessionId])
}

model SystemStat {
  id        String   @id @default(cuid())
  label     String
  value     String
  icon      String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([order])
}

model CareerResource {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  excerpt       String
  content       String?
  category      String
  coverImage    String?
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  fileUrl       String?
  link          String?
  type          String?  @default("text")
  downloadCount Int      @default(0)

  @@index([category])
  @@index([published])
  @@index([slug])
}

model Visitor {
  id        String   @id @default(cuid())
  sessionId String
  page      String?
  referrer  String?
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([createdAt])
  @@index([page])
}

model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  userType  String
  subject   String
  message   String
  company   String?
  createdAt DateTime  @default(now())
  status    String    @default("NEW")
  reply     String?
  repliedAt DateTime?
  repliedBy String?

  @@index([status])
  @@index([createdAt])
  @@index([email])
}

model Admin {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  name      String?
  role      String    @default("ADMIN")
  createdAt DateTime  @default(now())
  lastLogin DateTime?

  @@index([email])
  @@index([role])
}

model DailyStat {
  id                String   @id @default(cuid())
  date              DateTime @unique
  totalVisitors     Int      @default(0)
  totalViews        Int      @default(0)
  totalClicks       Int      @default(0)
  applications      Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  newSubscribers    Int      @default(0)
  blogClicks        Int      @default(0)
  blogViews         Int      @default(0)
  uniqueBlogReaders Int      @default(0)

  @@index([date])
}

model Blog {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String?
  excerpt     String?
  coverImage  String?
  author      String?  @default("Admin")
  category    String?
  tags        String[]
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  views       Int      @default(0)
  clicks      Int      @default(0)
  avgReadTime Int?
  
  @@index([slug])
  @@index([published])
  @@index([category])
  @@index([publishedAt])
  @@index([author])
}
model BlogView {
  id        String   @id @default(cuid())
  blogId    String
  sessionId String?
  ipAddress String?
  userAgent String?
  referrer  String?
  readTime  Int?
  viewedAt  DateTime @default(now())
  
  @@index([blogId])
  @@index([sessionId])
  @@index([viewedAt])
}

model BlogClick {
  id        String   @id @default(cuid())
  blogId    String
  sessionId String?
  targetUrl String
  linkText  String?
  linkType  String?
  clickedAt DateTime @default(now())
  
  @@index([blogId])
  @@index([sessionId])
  @@index([clickedAt])
}
model Subscriber {
  id               String            @id @default(cuid())
  email            String            @unique
  createdAt        DateTime          @default(now())
  clickCount       Int               @default(0)
  emailCount       Int               @default(0)
  ipAddress        String?
  lastEmailSent    DateTime?
  name             String?
  openCount        Int               @default(0)
  preferences      Json?
  source           String?
  status           String            @default("ACTIVE")
  subscribedAt     DateTime          @default(now())
  unsubscribedAt   DateTime?
  updatedAt        DateTime          @updatedAt
  userAgent        String?
  frequency        String?
  interestedIn     String?
  emailLogs        EmailLog[]
  newsletterEmails NewsletterEmail[]

  @@index([email])
  @@index([status])
  @@index([subscribedAt])
  @@index([interestedIn])
  @@index([frequency])
}

model NewsletterCampaign {
  id                String            @id @default(cuid())
  title             String
  subject           String
  content           String
  previewText       String?
  status            String            @default("DRAFT")
  scheduledFor      DateTime?
  sentAt            DateTime?
  targetAudience    String?
  totalSent         Int               @default(0)
  totalOpened       Int               @default(0)
  totalClicked      Int               @default(0)
  totalUnsubscribed Int               @default(0)
  createdBy         String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  emails            NewsletterEmail[]

  @@index([status])
  @@index([sentAt])
  @@index([scheduledFor])
}

model NewsletterEmail {
  id           String             @id @default(cuid())
  campaignId   String
  subscriberId String
  status       String             @default("PENDING")
  sentAt       DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?
  openedCount  Int                @default(0)
  clickedCount Int                @default(0)
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  campaign     NewsletterCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriber   Subscriber         @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([subscriberId])
  @@index([status])
  @@index([sentAt])
}

model EmailLog {
  id           String     @id @default(cuid())
  subscriberId String
  emailType    String
  subject      String
  status       String
  errorMessage String?
  sentAt       DateTime   @default(now())
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@index([subscriberId])
  @@index([sentAt])
  @@index([status])
}

model Feedback {
  id         String    @id @default(cuid())
  name       String    @default("Anonymous")
  email      String?
  rating     Int
  comment    String    @default("")
  page       String    @default("/")
  sessionId  String?
  category   String?
  userAgent  String?
  ipAddress  String?
  country    String?
  device     String?
  status     String    @default("NEW")
  adminNotes String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  reviewedAt DateTime?
  reviewedBy String?

  @@index([rating])
  @@index([status])
  @@index([createdAt])
  @@index([page])
  @@index([category])
  @@index([sessionId])
}
